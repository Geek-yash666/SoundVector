# Optional Gemini song insights. Leave empty to use catalog notes only.
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional Last.fm similar-track/artist evidence and metadata.
# Only the API key is used; no shared secret or user session token is needed.
LASTFM_API_KEY=

# Public Apple catalog storefront, not a listening-language preference.
# No Apple developer token is used by the public playlist integration.
APPLE_MUSIC_STOREFRONT=us

# Only needed when the trained artifacts are missing locally.
# Dataset files must be at the dataset root and come from one trained export.
# HF_ARTIFACTS_DATASET=owner/soundvector-artifacts
# HF_TOKEN=

# Optional overrides. PORT takes precedence over the CLI --port argument.
# PORT=8000
# SOUNDVECTOR_CACHE_DIR=/absolute/path/to/soundvector-cache

# Keep comments on their own lines. Do not add export prefixes or inline comments.
# Restart the Python server after changing this file.
